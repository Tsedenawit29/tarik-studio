{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard",
  "description": "The contract between every pipeline stage.",
  "type": "object",
  "required": ["title", "language", "audience", "intent", "style_block", "character", "music", "shots", "end_card"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "logline": { "type": "string" },
    "language": { "type": "string", "description": "BCP-47 narration language, e.g. am-ET" },
    "audience": { "type": "string", "minLength": 10 },
    "intent": { "type": "string", "minLength": 10, "description": "What the audience should feel/understand at the end" },
    "style_block": { "type": "string", "minLength": 10, "description": "Appended to every image prompt" },
    "negative_style": { "type": "string" },
    "character": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string", "minLength": 10 },
        "real_person": { "type": "boolean", "description": "If true, ETHICS.md must hold a consent record" },
        "seed": { "type": "integer" }
      }
    },
    "narration_style": { "type": "string", "default": "calm, warm, unhurried" },
    "narration_voice": { "type": "string" },
    "music": {
      "type": "object",
      "required": ["caption", "duration_s", "instrumental"],
      "additionalProperties": false,
      "properties": {
        "caption": { "type": "string", "minLength": 10 },
        "bpm": { "type": "integer", "minimum": 40, "maximum": 200 },
        "key": { "type": "string" },
        "duration_s": { "type": "number", "minimum": 30, "maximum": 120 },
        "instrumental": { "type": "boolean" },
        "seed": { "type": "integer" },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at_s", "note"],
            "additionalProperties": false,
            "properties": { "at_s": { "type": "number" }, "note": { "type": "string" } }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "reason", "shot_size", "image_prompt", "motion_prompt", "narration", "seed"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^s[0-9]{2}$" },
          "reason": { "type": "string", "minLength": 10, "description": "Why this shot exists, in one sentence" },
          "shot_size": { "enum": ["extreme_wide", "wide", "medium", "medium_close", "close", "extreme_close", "insert"] },
          "image_prompt": { "type": "string", "minLength": 10 },
          "motion_prompt": { "type": "string", "minLength": 5, "description": "Motion and camera only" },
          "motion": { "enum": ["wan", "kenburns"], "default": "kenburns" },
          "kenburns": { "enum": ["push_in", "pull_out", "pan_left", "pan_right", "tilt_up"], "default": "push_in" },
          "seed": { "type": "integer" },
          "min_duration_s": { "type": "number", "minimum": 2, "maximum": 10 },
          "narration": {
            "type": "object",
            "required": ["text", "english"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "description": "Narration in the film language, exactly as TTS should speak it" },
              "english": { "type": "string", "description": "English subtitle" }
            }
          }
        }
      }
    },
    "end_card": {
      "type": "object",
      "required": ["text", "duration_s"],
      "additionalProperties": false,
      "properties": { "text": { "type": "string" }, "duration_s": { "type": "number", "minimum": 2, "maximum": 4 } }
    }
  }
}
